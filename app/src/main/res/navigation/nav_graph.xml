<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Member 4: Authentication Screens -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.property_listing_system.Member4.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.property_listing_system.Member4.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Member 4 & 7: Central Application Dashboard -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.property_listing_system.Member4.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_propertyListFragment"
            app:destination="@id/propertyListFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_addEditPropertyFragment"
            app:destination="@id/addEditPropertyFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_member6Fragment"
            app:destination="@id/member6Fragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_member2Fragment"
            app:destination="@id/member2Fragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/dashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Member 5: Property Catalog & Forms -->
    <fragment
        android:id="@+id/propertyListFragment"
        android:name="com.example.property_listing_system.member5.PropertyListFragment"
        android:label="Property Catalog"
        tools:layout="@layout/fragment_property_list">
        <argument
            android:name="filterMyListings"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_to_addEditProperty"
            app:destination="@id/addEditPropertyFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditPropertyFragment"
        android:name="com.example.property_listing_system.member5.AddEditPropertyFragment"
        android:label="Add / Edit Property"
        tools:layout="@layout/fragment_add_edit_property">
        <argument
            android:name="propertyId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- Member 6: Network, Valuation & WorkManager Background Services -->
    <fragment
        android:id="@+id/member6Fragment"
        android:name="com.example.property_listing_system.ui.member6.Member6Fragment"
        android:label="Valuation &amp; Background Sync" />

    <!-- Member 2: Room Database Console -->
    <fragment
        android:id="@+id/member2Fragment"
        android:name="com.example.property_listing_system.ui.member2.Member2Fragment"
        android:label="Room Database Console" />

</navigation>
