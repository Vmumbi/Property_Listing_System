<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Top Header & Dark Mode Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPortalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Property Portal"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_primary" />

                <TextView
                    android:id="@+id/tvUserWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signed in as: User"
                    android:textSize="13sp"
                    android:textColor="@color/theme_text_secondary" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙 Dark Mode"
                android:textSize="12sp"
                android:textColor="@color/theme_text_primary"
                app:useMaterialThemeColors="true" />
        </LinearLayout>

        <!-- BUYER PORTAL ACTIONS -->
        <LinearLayout
            android:id="@+id/layoutBuyerActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnBuyerBrowse"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🏢  Browse Properties &amp; Contacts"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/blue_primary"
                app:cornerRadius="10dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnBuyerValuation"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="📍  Property Valuation Calculator"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/blue_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="10dp"
                android:layout_marginBottom="24dp" />
        </LinearLayout>

        <!-- AGENT PORTAL ACTIONS -->
        <LinearLayout
            android:id="@+id/layoutAgentActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAgentBrowseAll"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🏢  Browse All Properties"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/blue_primary"
                app:cornerRadius="10dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAgentMyListings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="📋  My Listed Properties"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/blue_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="10dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAgentAddProperty"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="➕  Add Property (Offline / Online)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/blue_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="10dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAgentUploadOffline"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="☁️  Upload Offline Properties to Cloud"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/blue_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="10dp"
                android:layout_marginBottom="24dp" />
        </LinearLayout>

        <!-- ADMIN PORTAL ACTIONS -->
        <LinearLayout
            android:id="@+id/layoutAdminActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAdminBrowseAll"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🏢  Browse &amp; Manage All Properties"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/blue_primary"
                app:cornerRadius="10dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAdminAddProperty"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="➕  Add New Property (Monthly / Yearly)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/blue_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="10dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAdminDatabaseConsole"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="💾  Room Database Console"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/blue_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="10dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAdminSyncCloud"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="☁️  Upload Offline Properties to Cloud"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/blue_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="10dp"
                android:layout_marginBottom="24dp" />
        </LinearLayout>

        <!-- Sign Out Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Sign Out"
            android:textColor="@color/theme_text_secondary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
