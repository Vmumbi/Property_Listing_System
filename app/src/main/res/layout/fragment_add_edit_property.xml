<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property Details Form"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter property specifications to save to Room database"
            android:textSize="12sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Property Title (min 3 chars)"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/navy_text_muted"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Detailed Description"
            android:minLines="3"
            android:gravity="top"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/navy_text_muted"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Price (KES)"
            android:inputType="numberDecimal"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/navy_text_muted"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Property Type:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/blue_primary"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerPropertyType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="@color/blue_light_bg"
            android:padding="8dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Address (e.g. Rhapta Road, Westlands)"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/navy_text_muted"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="City"
            android:text="Nairobi"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/navy_text_muted"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etBedrooms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Bedrooms"
                android:inputType="number"
                android:textColor="@color/theme_text_primary"
                android:textColorHint="@color/navy_text_muted"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etBathrooms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Bathrooms"
                android:inputType="number"
                android:textColor="@color/theme_text_primary"
                android:textColorHint="@color/navy_text_muted" />
        </LinearLayout>

        <EditText
            android:id="@+id/etSquareFootage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Square footage (sq ft)"
            android:inputType="numberDecimal"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/navy_text_muted"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etContactPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contact Phone (+254...)"
            android:inputType="phone"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/navy_text_muted"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etContactEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contact Email"
            android:inputType="textEmailAddress"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/navy_text_muted"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Save Property to Database"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue_primary"
            app:cornerRadius="10dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
